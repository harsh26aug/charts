{
  "name": "api-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js --dataSource data-source.ts",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:generate": "npm run typeorm migration:generate src/migrations/Migration",
    "migration:show": "npm run typeorm migration:show",
    "nifty50csv:import": "ts-node -r tsconfig-paths/register src/scripts/nifty50-import-csv.ts",
    "nifty50diff:pull": "ts-node -r tsconfig-paths/register src/scripts/nifty50-pull-diff.ts",
    "nifty50": "npm run nifty50csv:import && npm run nifty50diff:pull",
    "sensexcsv:import": "ts-node -r tsconfig-paths/register src/scripts/sensex-import-csv.ts",
    "sensexdiff:pull": "ts-node -r tsconfig-paths/register src/scripts/sensex-pull-diff.ts",
    "sensex": "npm run sensexcsv:import && npm run sensexdiff:pull",
    "elastic:sync": "ts-node -r tsconfig-paths/register src/scripts/elastic-sync-stocks.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "strip-bom-stream": "^5.0.0",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
